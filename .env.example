# Copy to .env and fill in. .env is ignored by git.

# Required: Anthropic API key (https://console.anthropic.com).
ANTHROPIC_API_KEY=

# Optional: PydanticAI model string. Default: anthropic:claude-haiku-5-5
# MODEL=anthropic:claude-sonnet-5-5

# Optional: fixed "now" for demos and evals, ISO 8601, Campo Grande local time.
# AGENT_NOW=2026-11-03T15:30
